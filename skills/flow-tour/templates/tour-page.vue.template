}

/* 布尔控件：原生勾选框换成拨杆开关 */
.tour-gui :deep(.lil-boolean .lil-widget input) {
  appearance: none;
  position: relative;
  width: 40px;
  height: 22px;
  margin: 0;
  border-radius: 999px;
  background: oklch(0.94 0.012 105 / 0.14);

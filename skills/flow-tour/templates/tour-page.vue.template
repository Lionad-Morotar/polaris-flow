    display: none;
  }

  .params-btn {
    display: inline-flex;
  }

  /* 目录变顶部横滑 chips，仍是半透明浮动面板 */
  .toc {
    top: var(--masthead-h);
    left: 0;
    right: 0;
    bottom: auto;
    width: auto;
    padding: 10px 12px;
    border-right: none;
    border-bottom: 1px solid var(--hairline);
  }

  /* 移动端目录是全宽 chips 横滑条：左侧不再被占用（left 归零）；
     其高度随内容自适应，底边无法纯 CSS 表达，由 JS 量测写入 --toc-bottom */
  .stage-canvas {
    left: 0;
    top: var(--toc-bottom, calc(var(--masthead-h) + 100px));
  }

  .toc-label,
  .toc-foot,
  /* 移动端 chips 横滑条不插篇章标题行：步骤已够长，标题会割裂横滑节奏 */
  .toc-act-title {
    display: none;
  }

  .toc-grip {
    display: none;
  }

  .toc-list {
    flex-direction: row;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 2px;
  }

  .toc-item {
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    background: oklch(0.94 0.012 105 / 0.05);
    scroll-snap-align: start;
  }

  .toc-num {
    min-width: 0;
    font-size: 18px;
  }

  .toc-title {
    font-size: 15px;
    white-space: nowrap;
  }

  .toc-actions {
    margin-top: 10px;
  }

  .fig-caption {
    left: 14px;
    bottom: calc(var(--article-h) + 12px);
    font-size: 14px;
  }

  .article {
    grid-template-columns: 1fr;
    gap: 14px;
    padding: 4px 18px 18px;
  }

  .article-title {
    font-size: 30px;
  }

  .article-side {
    padding-top: 0;
  }

  /* 参数面板变底部抽屉：用更亮更不透明的底色 + 更强描边与阴影，
     与同样半透明的文章区拉开层级，否则会糊成一片 */
  .params-sheet {
    top: auto;
    left: 10px;
    right: 10px;
    bottom: calc(var(--article-h) + 8px);
    z-index: 60;
    background: oklch(0.25 0.014 105 / 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid oklch(0.94 0.012 105 / 0.2);
    border-radius: 14px;
    box-shadow: 0 -12px 48px oklch(0.08 0.005 100 / 0.7);
    /* 关闭态：自身高度 + 文章区高度 + 边距一起下移，确保完全藏到屏幕外；
       打开时回到 bottom: article-h+8，正好卡在文章区上沿 */
    transform: translateY(calc(100% + var(--article-h) + 24px));
    transition: transform 0.38s var(--ease-out-quart);
  }

  /* 抽屉顶部的握持胶囊，传达"可拉起/可收起"的区域感 */
  .params-sheet::before {
    content: "";
    position: absolute;
    top: 7px;
    left: 50%;
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: oklch(0.94 0.012 105 / 0.3);
    transform: translateX(-50%);

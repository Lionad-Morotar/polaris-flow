  max-width: 216px;
  margin-left: auto;
}

/* 文本输入统一为能容纳 6 位 hex 的固定宽度，各类控件的右边缘由此对齐 */
.tour-gui :deep(.lil-widget input[type="text"]) {
  width: 68px;

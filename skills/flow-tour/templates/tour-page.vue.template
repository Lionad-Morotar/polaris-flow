}

.tour-gui :deep(.lil-display) {
  flex: 1;
}

/* 布尔开关：单独占一行控件位时右对齐，与输入框右边缘齐平 */
.tour-gui :deep(.lil-boolean .lil-widget) {
  justify-content: flex-end;
}

/* 数字输入框：右对齐小胶囊，与滑杆视觉分层 */
.tour-gui :deep(.lil-number input) {
  background: oklch(0.94 0.012 105 / 0.07);

}

/* 关键技术与代码位置统一排版：标签 + 胶囊芯片行 */
.meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: var(--ink-38);
}

.code-link {
  padding: 0;

  font-size: 14px;
  color: var(--ink-38);
}

/* ===== 步骤过渡与入场编排 ===== */
.stepfade-enter-active {
  transition: opacity 0.28s var(--ease-out-quart) 0.05s, transform 0.28s var(--ease-out-quart) 0.05s;
}

.stepfade-leave-active {
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.stepfade-enter-from {
  opacity: 0;
  transform: translateY(10px);
}

.stepfade-leave-to {
  opacity: 0;
  transform: translateY(-6px);
}

.masthead,
.toc,
.stage,
.article-slot {
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.7s var(--ease-out-quart), transform 0.7s var(--ease-out-quart);
}

.booted .masthead {
  opacity: 1;
  transform: none;
  transition-delay: 0.02s;
}

.booted .toc {
  opacity: 1;
  transform: none;
  transition-delay: 0.12s;
}

.booted .stage {
  opacity: 1;
  transform: none;
  transition-delay: 0.2s;
}

.booted .article-slot {
  opacity: 1;
  transform: none;
  transition-delay: 0.28s;
}

.toc-item {
  opacity: 0;
  transform: translateX(-6px);
  /* reveal 错峰 delay 仅作用于 opacity/transform；hover 的 background/color 保持 0 delay，手感不拖 */
  transition: opacity 0.5s var(--ease-out-quart) var(--reveal-delay, 0s),
    transform 0.5s var(--ease-out-quart) var(--reveal-delay, 0s), background 0.2s, color 0.2s;
}

.booted .toc-item {
  opacity: 1;
  transform: none;
}

/* 篇章标题行：组间留白分隔各幕，非交互（pointer-events:none 兜底，模板已非 button）；
   不另设 reveal 延迟，随 .toc 容器级淡入即可，避免标题与首项错峰割裂 */
.toc-act-title {
  margin: 16px 6px 4px;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-38);
  pointer-events: none;
}

/* 首幕标题顶边不留白，避免目录顶端空一行 */
.toc-list > .toc-act-title:first-child {
  margin-top: 2px;
}

/* ===== 响应式 ===== */
@media (max-width: 1100px) {
  .article {
    gap: 20px;
  }
}

@media (max-width: 767px) {
  .<tour-name>-tour {
    --masthead-h: 64px;
  }

  .masthead {
    align-items: center;
    padding: 0 16px;
  }

  .wordmark {
    font-size: 26px;
  }

  .masthead-sub {
    display: none;
  }

  /* 报头右侧 390px 放不下完整期号组；期号在文章区 folio 已有重复信息 */
  .meta-step,

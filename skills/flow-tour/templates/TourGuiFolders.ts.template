/**
 * <TourName> Tour 的 lil-gui 字段元数据。
 *
 * 每个字段定义：
 * - key: 对应 tourConfig 的字段路径（支持嵌套用点号，如 effect.tailRatio）
 * - stepId: 该字段首次出现的 step id
 * - label: 面板显示名称
 * - type: lil-gui 控制器类型
 * - min/max/step: number / range 类型用
 * - options: select 类型用
 * - hidden: 是否不在面板中显示（仅用于 patch 字段一致性校验）
 *
 * 以下示例字段仅作占位，请根据实际 `TourConfig` 替换。
 */

export type GuiFieldType = "color" | "number" | "range" | "select" | "boolean";

export interface GuiFieldDefinition {
  key: string;
  stepId: string;
  label: string;
  type: GuiFieldType;
  min?: number;
  max?: number;
  step?: number;
  options?: string[];
  hidden?: boolean;
}

export const <TourName>TourGuiFields: GuiFieldDefinition[] = [
  {
    key: "paramA",
    stepId: "param-a",
    label: "参数 A",
    type: "number",
    min: 0,
    max: 100,
    step: 1
  },
  {
    key: "paramB",
    stepId: "param-b",
    label: "参数 B",
    type: "color"
  },
  {
    key: "mode",
    stepId: "param-c",
    label: "模式",
    type: "select",
    options: ["mode-a", "mode-b", "mode-c"]
  },
  {
    key: "nested.ratio",
    stepId: "param-d",
    label: "嵌套比例",
    type: "range",
    min: 0,
    max: 1,
    step: 0.01
  }
];

/**
 * 获取指定 step 可调字段。
 */
export function getGuiFieldsForStep(stepId: string): GuiFieldDefinition[] {
  return <TourName>TourGuiFields.filter(
    (field) => field.stepId === stepId && !field.hidden
  );
}

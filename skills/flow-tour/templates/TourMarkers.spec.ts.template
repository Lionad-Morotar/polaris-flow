import { describe, expect, it } from "vitest";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import rawMarkers from "~/assets/tour/<tour-name>-tour-markers.json";
import { resolve<TourName>TourMarkers } from "~/scripts/resolve-<tour-name>-tour-markers";
import { <TourName>TourSteps } from "~/config/tour/<tour-name>TourSteps";

const repoRoot = resolve(import.meta.dirname, "..", "..");

describe("<TourName> Tour Markers", () => {
  it("每个 step 引用的 marker 都能在产物中找到", () => {
    const markers = rawMarkers as Record<string, { file: string; line: number }>;
    for (const step of <TourName>TourSteps) {
      for (const location of step.codeLocations) {
        expect(markers[location], `step "${step.id}" 引用缺失 marker: ${location}`).toBeDefined();
      }
    }
  });

  it("已入库 JSON 与 resolver 实时扫描结果一致", () => {
    const live = resolve<TourName>TourMarkers();
    expect(rawMarkers).toEqual(live);
  });

  it("若生成 CodeTour，step 数与定义一致且 file/line 匹配", () => {
    const tourPath = resolve(repoRoot, ".vscode/tours", "<taskname>.tour");
    const tourFile = JSON.parse(readFileSync(tourPath, "utf-8"));
    const live = resolve<TourName>TourMarkers();

    expect(tourFile.steps.length).toBe(<TourName>TourSteps.length);

    let markerIndex = 0;
    for (const step of <TourName>TourSteps) {
      for (const location of step.codeLocations) {
        const saved = tourFile.steps[markerIndex];
        const liveMarker = live[location];
        expect(saved, `step "${step.id}" 缺少对应 CodeTour step`).toBeDefined();
        expect(saved.file).toBe(liveMarker.file);
        expect(saved.line).toBe(liveMarker.line);
        markerIndex++;
      }
    }
  });
});

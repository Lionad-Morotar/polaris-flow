# flow-mem 知识库数据为本地积累，不入版本控制（知识随 --learn 持续增长且个人化，
# 不随技能版本库分发；技能本体 SKILL.md、scripts/、learn.md/search.md 仍跟踪）
skills/flow-mem/references/framework/

# flow-mem 决策切片同理：用户偏好与决策含任务语境细节，本地积累不随技能版本库分发
skills/flow-mem/references/decisions/

# flow-web 站点 playbook 为本地积累，随使用持续增长且含内部系统操作细节，
# 不随技能版本库分发；技能本体 SKILL.md、scripts/、configs/、evals/ 仍跟踪
skills/flow-web/references/

# flow-web 工作区绑定与 UUID 缓存为本机运行时状态（记录本机项目路径与工作区名），
# 不随技能版本库分发；脚本首用时自建空缓存，本地文件保留不清理
skills/flow-web/configs/workspace-bindings.json
skills/flow-web/configs/workspace-uuids.json

# flow-app 应用手册为本地积累（手册由用户主动编写沉淀，含本机应用操作细节），
# 不随技能版本库分发；技能本体 SKILL.md 仍跟踪
skills/flow-app/references/

# flow-agent 技能本体随仓分发；configs/ 为本机启动器链配置（含账号级 zsh function 名），
# 不随开源仓分发；launchers.example.json 为入库模板
skills/flow-agent/configs/*
!skills/flow-agent/configs/launchers.example.json

# flow-os 技能本体随仓分发；configs/ 为本机 provider 账册（真实账号名册），不随开源仓分发
skills/flow-os/configs/

# 仓级敏感词黑名单为 owner 本机私有(真实手机号/内部域名/口令,入库即公开),
# 格式契约见 configs/secret-scan.example.txt;仅模板入库
/configs/*
!/configs/secret-scan.example.txt
